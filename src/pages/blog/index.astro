---
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Tech from '../../components/Tech.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---

<Layout title="Writing — Juan David Lipez" description="Notes on things I've built.">
	<main class="mx-auto max-w-2xl px-6 pt-10 pb-20 text-[14px] leading-[1.45] sm:pt-20 sm:pb-36">
		<Header>
			{/*
				Nombra a dónde va y no de dónde vienes, igual que el de la entrada dice
				"Writing". A este se puede llegar de fuera, y a quien llega de fuera
				un "back" no le dice nada: no ha estado en ninguna parte.

				Y con la cara en vez de una flecha, que además es lo que viaja: la
				misma foto está en la portada a 48, así que el navegador la empareja y
				la lleva de un tamaño al otro.
			*/}
			<a
				href="/"
				data-sound="back"
				data-sound-hover
				class="volver flex items-center gap-2 text-neutral-500"
			>
				<img
					src="/logos/avatar.jpg"
					alt=""
					width="28"
					height="28"
					class="foto-perfil size-7 rounded-full"
				/>
				Juan David Lipez
			</a>
		</Header>

		<h1 class="text-neutral-100">Writing</h1>
		<p class="text-neutral-500">Notes on what I build, and the parts that were harder than they looked.</p>

		<ul class="mt-6" data-sound-detent>
			{
				posts.map((post) => (
					<li class="border-b border-neutral-900 last:border-b-0">
						{/*
							draggable en false porque dentro va una pegatina que sí se
							arrastra. Sin esto el navegador arranca su arrastre nativo de
							enlace en cuanto el dedo se mueve: sale el fantasma del enlace
							con su cursor de "copiar aquí" y la pegatina se queda detrás.
							Lo único que se pierde es poder soltar la URL en la barra de
							marcadores.
						*/}
						<a
							href={`/blog/${post.id}`}
							draggable="false"
							data-sound="nav"
							data-sound-hover
							class="-mx-2 flex items-start gap-4 rounded-lg px-2 py-2.5 transition-colors hover:bg-neutral-900/70"
						>
							<span class="min-w-0 flex-1">
								<span class="titulo text-neutral-100">{post.data.title}</span>
								<time class="ml-2 text-neutral-500" datetime={post.data.date.toISOString()}>
									{post.data.date.toLocaleDateString('en', { month: 'short', year: 'numeric' })}
								</time>
								<span class="mt-1 block text-neutral-400">{post.data.description}</span>
							</span>
							<span class="shrink-0 pt-0.5">
								<Tech techs={post.data.techs} slug={post.id} lado={26} />
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>

<style>
	h1 {
		font-size: 1rem;
		font-weight: 400;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	.volver {
		text-decoration: none;
	}
	/* Más grande que el resto: en una lista de tres cosas, el título es lo único
	   que se lee de un vistazo. La fecha y el resumen van a la medida de la página. */
	.titulo {
		font-size: 1.0625rem;
		line-height: 1.3;
	}
</style>
