---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Header from '../../components/Header.astro';
import { iconoDe, nombreDeTransicion } from '../../lib/techs';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
---

<Layout title="Writing — Juan David Lipez" description="Notes on things I've built.">
	<main class="mx-auto max-w-2xl px-6 pt-10 pb-20 text-[14px] leading-[1.45] sm:pt-20 sm:pb-36">
		<Header>
			<a href="/" data-sound="back" data-sound-hover class="volver text-neutral-500">&larr; Back</a>
		</Header>

		<h1 class="text-neutral-100">Writing</h1>
		<p class="text-neutral-500">Notes on what I build, and the parts that were harder than they looked.</p>

		<ul class="mt-6" data-sound-detent>
			{
				posts.map((post) => (
					<li class="border-b border-neutral-900 last:border-b-0">
						<a
							href={`/blog/${post.id}`}
							data-sound="nav"
							data-sound-hover
							class="-mx-2 flex items-start gap-4 rounded-lg px-2 py-2.5 transition-colors hover:bg-neutral-900/70"
						>
							<span class="min-w-0 flex-1">
								<span class="titulo text-neutral-100">{post.data.title}</span>
								<time class="ml-2 text-neutral-500" datetime={post.data.date.toISOString()}>
									{post.data.date.toLocaleDateString('en', { month: 'short', year: 'numeric' })}
								</time>
								<span class="mt-1 block text-neutral-400">{post.data.description}</span>
							</span>
							<span class="flex shrink-0 gap-2 pt-0.5">
								{post.data.techs.map((tech) => (
									<Icon
										name={iconoDe(tech)}
										title={tech}
										class="size-4"
										style={`view-transition-name: ${nombreDeTransicion(post.id, tech)}`}
									/>
								))}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>

<style>
	h1 {
		font-size: 1rem;
		font-weight: 400;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	.volver {
		text-decoration: none;
	}
	/* Más grande que el resto: en una lista de tres cosas, el título es lo único
	   que se lee de un vistazo. La fecha y el resumen van a la medida de la página. */
	.titulo {
		font-size: 1.0625rem;
		line-height: 1.3;
	}
</style>
