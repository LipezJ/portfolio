---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Entry from '../components/Entry.astro';
import More from '../components/More.astro';
import ExternalLink from '../components/ExternalLink.astro';
import SoundToggle from '../components/SoundToggle.astro';

const GITHUB = 'https://github.com/LipezJ';
const SCALE = 'https://scale.com';
const CALUMET = 'https://calumet.uis.edu.co';
const EMAIL = 'juandavidlipez47@gmail.com';
---

<Layout title="Juan David Lipez">
	<main class="mx-auto max-w-2xl px-6 py-10 pb-20 text-[14px] leading-[1.45] sm:py-20">
		<div class="mb-10 flex items-center justify-between">
			{/* Avatar de GitHub servido desde el sitio, no enlazado a github.com:
			    así no se rompe si cambia su CDN ni depende de una petición externa. */}
			<img
				src="/logos/avatar.jpg"
				alt=""
				width="32"
				height="32"
				class="size-8 rounded-full"
			/>
			<SoundToggle />
		</div>

		<h1 class="text-neutral-100">Hi! I&rsquo;m Juan David.</h1>
		<p class="text-neutral-500">
			You can call me &ldquo;<span data-sound-hover data-ripple>Lipez</span>&rdquo;
		</p>

		<p class="mt-6">
			I&rsquo;m a Software Engineer studying Systems Engineering in Bucaramanga, Colombia. I enjoy
			building software, making it efficient, and finding new ways to solve problems.
		</p>

		<p class="mt-2">
			Currently a QC Auditor at <ExternalLink href={SCALE}>Scale AI</ExternalLink>{' '}<More color="#9333EA"
				>(I audit RLHF and SFT datasets before they ship)</More
			>, and lead developer at <ExternalLink href={CALUMET}>CALUMET</ExternalLink>, where I rebuilt
			COMA, the academic platform the whole campus runs on{' '}<More color="#4169E1"
				>(login went from 840 ms to 29 ms, heap from 1.40 GB to 69 MB)</More
			>. Also built Suamox{' '}<More color="#F97316">(server loaders and hybrid rendering, not just a build step)</More>, a
			React meta-framework with SSR and file-system routing.
		</p>

		<h2 class="mt-6 text-neutral-500">Work</h2>
		<div data-sound-detent>
			<Entry name="Scale AI" meta="2024 - Present" logo="/logos/scale.svg" chip="#000000">
				<p>
					QC Auditor since August 2025. I audit RLHF and SFT datasets before they reach the
					client: score each task against the rubric, write the feedback, and hold back what
					doesn&rsquo;t meet the bar. Started in 2024 as an AI Training Specialist.
				</p>
			</Entry>

			<Entry name="CALUMET" meta="2023 - Present" logo="/logos/calumet.png" chip="#ffffff">
				<p>
					Team Project Lead at the student engineering group of my university. I lead development
					on COMA, the academic platform, built on a 20-year-old Java EE monolith. Reworked its
					permissions around a single authorization filter and one shared cache, and now lead its
					rebuild in Java 25 and Spring Boot 4 with a React 19 SSR frontend.
				</p>
				<p class="mt-3">
					On the board since May 2024, where I set the roadmap and designed the architecture
					replacing the monolith.
				</p>
			</Entry>
		</div>

		<h2 class="mb-1 mt-6 text-neutral-500">Projects</h2>
		<div data-sound-detent>
			<Entry name="Suamox" meta="open source" color="#F97316" seed={0}>
				<p>
					A React meta-framework on Vite and Hono. File-system routing with dynamic, catch-all and
					grouped routes, server-side loaders, and hybrid rendering across SSR, SSG and the
					client.
				</p>
				<p class="mt-3">
					Seven npm packages: the routing Vite plugin, the core runtime that matches routes and
					runs loaders, the Hono adapter, head management, the client router, the CLI and the
					project scaffolder. Islands are next.
				</p>
			</Entry>

			<Entry name="Elise" meta="open source" color="#4169E1" seed={2.1}>
				<p>
					The design system behind CALUMET&rsquo;s apps. 87 React components in eleven packages
					covering UI, forms, tables, icons and i18n, plus an ESLint plugin that enforces their
					use.
				</p>
			</Entry>

			<Entry name="Server Functions with AI" meta="hackathon" color="#9333EA" seed={4.3}>
				<p>
					Function-as-a-service in the shape of AWS Lambda. Each function runs in an isolated
					JavaScript worker, and AI writes the deployment from a plain-language description.
				</p>
			</Entry>
		</div>

		<p class="mt-6">
			Wanna discuss a project or just say hi?
			<a href={`mailto:${EMAIL}`} data-sound="nav" data-sound-hover> Let&rsquo;s grab a coffee</a>
		</p>

		<p class="mt-2">
			You can find me on{' '}<a href={GITHUB} target="_blank" rel="noopener" data-sound="nav" data-sound-hover
				><Icon name="fa7-brands:github" class="inline size-[1em] align-[-0.125em]" />&#8239;GitHub</a
			>, or reach me via{' '}<a href={`mailto:${EMAIL}`} data-sound="nav" data-sound-hover
				><Icon name="fa7-solid:envelope" class="inline size-[1em] align-[-0.125em]" />&#8239;email</a
			>.
		</p>
	</main>
</Layout>

<style>
	h1 {
		font-size: 1rem;
		font-weight: 400;
	}
	h2 {
		font-size: 0.9375rem;
		font-weight: 400;
	}
	a {
		color: inherit;
		text-decoration: none;
		/*
			La línea va pintada como fondo, no como text-decoration. Un SVG es un
			elemento reemplazado y text-decoration no se dibuja sobre él, así que
			el subrayado se cortaba justo en los iconos.
		*/
		background-image: linear-gradient(var(--color-neutral-600), var(--color-neutral-600));
		background-repeat: no-repeat;
		background-size: 100% 1px;
		background-position: 0 calc(100% - 1px);
	}
	a:hover {
		background-image: linear-gradient(var(--color-neutral-300), var(--color-neutral-300));
	}
	/*
		Un SVG crea su propia oportunidad de corte de línea, y el espacio de
		no-ruptura no la suprime: el icono se quedaba al final de un renglón y
		el texto caía al siguiente. Solo afecta a los enlaces con icono, así
		que los enlaces largos de texto siguen partiendo con normalidad.
	*/
	a:has(svg) {
		white-space: nowrap;
	}
</style>
