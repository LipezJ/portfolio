---
import { Icon } from 'astro-icon/components';

/**
 * Tamaños distintos a propósito: si todas miden lo mismo la pila se lee como
 * una rejilla, no como pegatinas tiradas encima.
 */
const TECHS = [
	{ name: 'Java', icon: 'logos:java', size: 92 },
	{ name: 'TypeScript', icon: 'logos:typescript-icon', size: 80 },
	{ name: 'JavaScript', icon: 'logos:javascript', size: 76 },
	{ name: 'Rust', icon: 'logos:rust', size: 88 },
	{ name: 'Python', icon: 'logos:python', size: 84 },
	{ name: 'React', icon: 'logos:react', size: 96 },
	{ name: 'Go', icon: 'logos:gopher', size: 90 },
	{ name: 'Astro', icon: 'logos:astro-icon', size: 78 },
	{ name: 'Docker', icon: 'logos:docker-icon', size: 100 },
	{ name: 'Linux', icon: 'logos:linux-tux', size: 82 },
];

---

{/*
	La capa ocupa la ventana entera y no bloquea nada: pointer-events va en none
	aquí y en auto solo en cada pegatina, de modo que se pueden arrastrar por
	toda la pantalla sin que la página deje de funcionar por debajo.
*/}
{/*
	El troquelado de verdad. feMorphology con dilate engorda la silueta
	exactamente el radio pedido, con borde duro; drop-shadow no sirve porque
	desenfoca el alfa y al encadenar varias lo que se acumula es brillo, o sea
	un neón.

	El kernel de dilate es cuadrado y deja las esquinas en pico, así que después
	va un desenfoque corto que las redondea y un feComponentTransfer que vuelve
	a saturar el alfa para recuperar el canto limpio. sRGB explícito: en el
	linearRGB por defecto el blanco del flood se va de tono.
*/}
<svg width="0" height="0" aria-hidden="true" style="position:absolute">
	<filter id="diecut" x="-35%" y="-35%" width="170%" height="170%" color-interpolation-filters="sRGB">
		<feMorphology in="SourceAlpha" operator="dilate" radius="3" result="gordo" />
		<feGaussianBlur in="gordo" stdDeviation="1.6" result="suave" />
		<feComponentTransfer in="suave" result="duro">
			<feFuncA type="linear" slope="14" intercept="-3" />
		</feComponentTransfer>
		<feFlood flood-color="#ffffff" result="blanco" />
		<feComposite in="blanco" in2="duro" operator="in" result="contorno" />
		<feMerge>
			<feMergeNode in="contorno" />
			<feMergeNode in="SourceGraphic" />
		</feMerge>
	</filter>
</svg>

<div data-stickers class="pointer-events-none fixed inset-0 z-30" aria-hidden="true">
	{
		TECHS.map((t) => (
			<span class="sticker" data-sticker style={`width:${t.size}px;height:${t.size}px`} title={t.name}>
				<Icon name={t.icon} class="size-full" />
			</span>
		))
	}
</div>

<style>
	.sticker {
		position: absolute;
		top: 0;
		left: 0;
		display: block;
		pointer-events: auto;
		cursor: grab;
		will-change: transform;
		user-select: none;
		-webkit-user-drag: none;
	}
	.sticker:active {
		cursor: grabbing;
	}

	/* El contorno lo pone el filtro SVG de arriba. */
	.sticker :global(svg) {
		filter: url(#diecut);
	}
	/*
		La sombra va aparte y en el envoltorio, no encadenada al contorno: así
		cae sobre la silueta ya engordada en vez de sobre el dibujo desnudo.
	*/
	.sticker {
		filter: drop-shadow(0 3px 6px rgb(0 0 0 / 0.55));
	}
</style>
