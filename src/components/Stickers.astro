---
import { Icon } from 'astro-icon/components';

/**
 * Tamaños distintos a propósito: si todas miden lo mismo la pila se lee como
 * una rejilla, no como pegatinas tiradas encima.
 */
const TECHS = [
	{ name: 'Java', icon: 'logos:java', size: 92 },
	{ name: 'TypeScript', icon: 'logos:typescript-icon', size: 80 },
	{ name: 'JavaScript', icon: 'logos:javascript', size: 76 },
	{ name: 'Rust', icon: 'logos:rust', size: 88 },
	{ name: 'Python', icon: 'logos:python', size: 84 },
	{ name: 'React', icon: 'logos:react', size: 96 },
	{ name: 'Go', icon: 'logos:gopher', size: 90 },
	{ name: 'Astro', icon: 'logos:astro-icon', size: 78 },
	{ name: 'Docker', icon: 'logos:docker-icon', size: 100 },
	{ name: 'Linux', icon: 'logos:linux-tux', size: 82 },
];

const PLACES = [
	{ name: 'CALUMET', src: '/logos/calumet.png', size: 104 },
	{ name: 'Scale AI', src: '/logos/scale-mark.svg', size: 74 },
];
---

{/*
	La capa ocupa la ventana entera y no bloquea nada: pointer-events va en none
	aquí y en auto solo en cada pegatina, de modo que se pueden arrastrar por
	toda la pantalla sin que la página deje de funcionar por debajo.
*/}
<div data-stickers class="pointer-events-none fixed inset-0 z-30" aria-hidden="true">
	{
		TECHS.map((t) => (
			<span class="sticker" data-sticker style={`width:${t.size}px;height:${t.size}px`} title={t.name}>
				<Icon name={t.icon} class="size-full" />
			</span>
		))
	}
	{
		PLACES.map((p) => (
			<span class="sticker" data-sticker style={`width:${p.size}px;height:${p.size}px`} title={p.name}>
				<img src={p.src} alt="" class="size-full object-contain" />
			</span>
		))
	}
</div>

<style>
	.sticker {
		position: absolute;
		top: 0;
		left: 0;
		display: block;
		pointer-events: auto;
		cursor: grab;
		will-change: transform;
		user-select: none;
		-webkit-user-drag: none;
	}
	.sticker:active {
		cursor: grabbing;
	}

	/*
		El troquelado. Varias drop-shadow encadenadas sin desplazamiento y con
		poco desenfoque engordan el canal alfa en todas direcciones, de modo que
		el blanco asoma siguiendo la silueta real del dibujo. Es lo que hace que
		parezca recortada con tijera y no un logo dentro de una bola.

		La última, esa sí desplazada y gris, es la sombra sobre el fondo.
	*/
	.sticker :global(svg),
	.sticker :global(img) {
		filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 3px #fff) drop-shadow(0 0 2px #fff)
			drop-shadow(0 0 2px #fff) drop-shadow(0 3px 5px rgb(0 0 0 / 0.5));
	}
</style>
