---
import { Icon } from 'astro-icon/components';
---

{/*
	La visita guiada: una mano que va señalando qué mirar.

	Va en su propia capa por encima de todo y sin recibir puntero, de modo que
	señala sin estorbar: se puede pulsar lo que está señalando mientras lo
	señala. Nace oculta y la enseña el script, que es quien decide si toca.
*/}
<div data-tour class="tour" aria-hidden="true" hidden>
	<div class="mano">
		<Icon name="fa7-solid:hand-pointer" class="dedo" />
	</div>
	<p class="dicho"></p>
</div>

<style>
	.tour {
		position: fixed;
		inset: 0;
		z-index: 50;
		pointer-events: none;
	}

	/*
		El sitio va en variables y no en top/left porque así lo mueve un transform,
		que el navegador compone sin volver a maquetar. Con top/left cada paso
		obligaría a recalcular la página entera.
	*/
	.mano,
	.dicho {
		position: absolute;
		top: 0;
		left: 0;
		transform: translate(var(--x, 0px), var(--y, 0px));
		transition:
			transform 0.65s cubic-bezier(0.65, 0, 0.35, 1),
			opacity 0.3s ease;
		will-change: transform;
	}

	/* Para el primer sitio, que si no llega volando desde la esquina. */
	.tour[data-quieto] .mano,
	.tour[data-quieto] .dicho {
		transition: none;
	}

	.tour[data-fuera] .mano,
	.tour[data-fuera] .dicho {
		opacity: 0;
	}

	/* 22px, y el mismo número está en tour.ts para colocar el globo debajo. */
	.dedo {
		display: block;
		width: 22px;
		height: 22px;
		color: #fff;
		/*
			Contorno oscuro, porque la mano blanca acaba encima de una pegatina y
			hay logos casi blancos: sobre la taza de Java desaparecía del todo.

			Va con stroke y no con sombras apiladas: el icono viene de un symbol
			referenciado con use, y los selectores no entran ahí dentro, pero stroke
			sí se hereda desde el svg. paint-order lo manda detrás del relleno, que
			si no se come el dibujo. El grosor está en unidades del viewBox, que es
			de 640, así que 34 son poco más de un píxel a 22.
		*/
		stroke: rgb(0 0 0 / 0.65);
		stroke-width: 34;
		paint-order: stroke;
		filter: drop-shadow(0 2px 5px rgb(0 0 0 / 0.5));
	}

	/*
		El toque va en el icono y no en la mano, que ya lleva el transform del
		viaje: dos transforms en el mismo elemento se pisan, y el de la animación
		gana mientras dura, así que la mano se iría a la esquina al señalar.
	*/
	@keyframes toque {
		0%,
		100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-7px);
		}
	}
	.mano[data-toca] .dedo {
		animation: toque 0.5s ease-out 2;
	}

	.dicho {
		margin: 0;
		padding: 0.3rem 0.6rem;
		border-radius: 0.5rem;
		background: var(--color-neutral-100);
		color: var(--color-neutral-900);
		font-size: 0.8125rem;
		line-height: 1.2;
		white-space: nowrap;
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.5);
	}

	/*
		El rabo del bocadillo, apuntando a la mano.

		Va en --rabo y no centrado, porque contra el canto de la pantalla el globo
		se desplaza para no salirse y el rabo tiene que quedarse donde está la
		mano. Es un triángulo hecho con bordes: los otros tres lados transparentes
		y el de abajo del color del globo.
	*/
	.dicho::before {
		content: '';
		position: absolute;
		top: -5px;
		left: var(--rabo, 50%);
		margin-left: -5px;
		border-left: 5px solid transparent;
		border-right: 5px solid transparent;
		border-bottom: 5px solid var(--color-neutral-100);
	}

	@media (prefers-reduced-motion: reduce) {
		/* La visita entera es movimiento. Sin movimiento no hay visita. */
		.tour {
			display: none;
		}
	}
</style>
