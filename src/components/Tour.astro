---
import { Icon } from 'astro-icon/components';
---

{/*
	La visita guiada: una mano que va señalando qué mirar.

	Va en su propia capa por encima de todo y sin recibir puntero, de modo que
	señala sin estorbar: se puede pulsar lo que está señalando mientras lo
	señala. Nace oculta y la enseña el script, que es quien decide si toca.
*/}
<div data-tour class="tour" aria-hidden="true" hidden>
	<div class="mano">
		<Icon name="fa7-solid:hand-pointer" class="dedo" />
	</div>
	<p class="dicho"></p>
</div>

<style>
	.tour {
		position: fixed;
		inset: 0;
		z-index: 50;
		pointer-events: none;
	}

	/*
		El sitio va en variables y no en top/left porque así lo mueve un transform,
		que el navegador compone sin volver a maquetar. Con top/left cada paso
		obligaría a recalcular la página entera.
	*/
	.mano,
	.dicho {
		position: absolute;
		top: 0;
		left: 0;
		transform: translate(var(--x, 0px), var(--y, 0px));
		transition:
			transform 0.65s cubic-bezier(0.65, 0, 0.35, 1),
			opacity 0.3s ease;
		will-change: transform;
	}

	/* Para el primer sitio, que si no llega volando desde la esquina. */
	.tour[data-quieto] .mano,
	.tour[data-quieto] .dicho {
		transition: none;
	}

	.tour[data-fuera] .mano,
	.tour[data-fuera] .dicho {
		opacity: 0;
	}

	.dedo {
		display: block;
		width: 28px;
		height: 28px;
		color: #fff;
		/* Blanco sobre fondo negro se pierde en el globo, que también es claro. */
		filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.8));
	}

	/*
		El toque va en el icono y no en la mano, que ya lleva el transform del
		viaje: dos transforms en el mismo elemento se pisan, y el de la animación
		gana mientras dura, así que la mano se iría a la esquina al señalar.
	*/
	@keyframes toque {
		0%,
		100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-7px);
		}
	}
	.mano[data-toca] .dedo {
		animation: toque 0.5s ease-out 2;
	}

	.dicho {
		margin: 0;
		padding: 0.3rem 0.6rem;
		border-radius: 0.5rem;
		background: var(--color-neutral-100);
		color: var(--color-neutral-900);
		font-size: 0.8125rem;
		line-height: 1.2;
		white-space: nowrap;
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		/* La visita entera es movimiento. Sin movimiento no hay visita. */
		.tour {
			display: none;
		}
	}
</style>
