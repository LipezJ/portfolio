---
interface Props {
	/** Texto del disparador mientras está plegado. */
	label?: string;
	/** Color del texto una vez desplegado. Por defecto, gris claro. */
	color?: string;
}

const { label = '(more)', color } = Astro.props;
---

{/*
	Es un <span> y no un <button> a propósito: los navegadores tratan los
	botones como caja atómica y fuerzan inline-block, así que el texto
	desplegado no podría partir de línea y saldría entero al renglón siguiente.
	Con role/tabindex/aria queda igual de accesible y fluye con el párrafo.
*/}
<span
	role="button"
	tabindex="0"
	data-more
	data-sound-hover
	style={color ? `--more-color: ${color}` : undefined}
	aria-expanded="false"
	class="more"
>
	<span data-more-short>{label}</span>
	<span data-more-full hidden><slot /></span>
</span>

<style>
	.more {
		color: var(--color-neutral-500);
		cursor: help;
		/* En los dos estados: sigue siendo el mismo control, plegado o no. Como
		   el subrayado hereda currentColor, desplegado se tiñe con el texto. */
		text-decoration: underline dotted;
		text-underline-offset: 3px;
		transition: color 0.22s ease;
	}
	.more:hover {
		color: var(--color-neutral-300);
	}
	/* Desplegado se tiñe del color del proyecto al que pertenece. */
	.more[aria-expanded='true'] {
		/*
			Mezclado hacia gris en vez del color puro: conserva el tono pero le
			quita el brillo eléctrico, que sobre un diseño tan apagado destacaba
			demasiado. De paso sube la luminancia del morado, que era el que peor
			contraste tenía.
		*/
		color: color-mix(
			in oklab,
			var(--more-color, var(--color-neutral-300)) 70%,
			var(--color-neutral-400)
		);
	}
	/*
		El texto revelado aparece de golpe porque pasa de display:none a visible,
		y sobre un cambio instantáneo la transición de color no se percibe. Una
		animación sí arranca al mostrarse el elemento, así que el fundido va ahí.
	*/
	[data-more-full]:not([hidden]) {
		animation: more-in 0.22s ease both;
	}
	@keyframes more-in {
		from {
			opacity: 0;
		}
	}
	.more:focus-visible {
		outline: 1px solid var(--color-neutral-500);
		outline-offset: 2px;
		border-radius: 2px;
	}
</style>

<script>
	import { sound } from '../lib/sound';

	function bindMore(root: ParentNode = document) {
		for (const el of root.querySelectorAll<HTMLElement>('[data-more]')) {
			if (el.dataset.moreBound !== undefined) continue;
			el.dataset.moreBound = '';

			const short = el.querySelector<HTMLElement>('[data-more-short]');
			const full = el.querySelector<HTMLElement>('[data-more-full]');
			if (!short || !full) continue;

			const toggle = () => {
				const open = el.getAttribute('aria-expanded') === 'true';
				el.setAttribute('aria-expanded', String(!open));
				short.hidden = !open;
				full.hidden = open;
				sound.play(open ? 'close' : 'reveal');
			};

			let downX = 0;
			let downY = 0;

			el.addEventListener('mousedown', (e) => {
				// El segundo mousedown de un doble clic es el que arranca la selección.
				// Lo cortamos ahí y no con user-select, para no romper el copiar.
				if (e.detail > 1) e.preventDefault();
				downX = e.clientX;
				downY = e.clientY;
			});

			el.addEventListener('click', (e) => {
				// Arrastrar también dispara click al soltar, y plegaba el texto justo
				// mientras lo seleccionabas. detail === 0 es un click de teclado.
				if (e.detail > 0 && Math.hypot(e.clientX - downX, e.clientY - downY) > 4) return;
				toggle();
			});
			el.addEventListener('keydown', (e) => {
				if (e.key !== 'Enter' && e.key !== ' ') return;
				e.preventDefault();
				toggle();
			});
		}
	}

	bindMore();
	document.addEventListener('astro:page-load', () => bindMore());
</script>
