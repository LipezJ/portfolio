---
import { Icon } from 'astro-icon/components';

interface Props {
	href: string;
	/** Cualquier otro atributo pasa al <a>. */
	[key: string]: unknown;
}

const { href, ...rest } = Astro.props;
---

{/*
	El icono se mide en em y no como carácter: con el ↗ que había antes, el
	glifo lo aportaba la fuente que el sistema tuviera para ese punto de
	código, cada una lo dibuja a un tamaño distinto dentro de su caja, y en
	móvil salía diminuto.

	Las utilidades de Tailwind van en el icono y no en el CSS de abajo: los
	estilos con ámbito de Astro pierden contra el preflight, que declara
	svg { display: block } y rompería la línea.
*/}
<a href={href} target="_blank" rel="noopener" data-sound="nav" data-sound-hover class="ext" {...rest}>
	<slot />&#8239;<Icon name="fa7-solid:link" class="inline size-[0.72em] align-[-0.02em]" />
</a>

<style>
	.ext {
		color: inherit;
		text-decoration: none;
		/*
			La línea va pintada como fondo y no como text-decoration, que no se
			dibuja sobre elementos reemplazados y se cortaría justo en la flecha.
			Es además lo que permite que la flecha sea un SVG.
		*/
		background-image: linear-gradient(var(--color-neutral-600), var(--color-neutral-600));
		background-repeat: no-repeat;
		background-size: 100% 1px;
		background-position: 0 calc(100% - 1px);
		/*
			Un SVG abre su propia oportunidad de corte de línea que el espacio de
			no-ruptura no suprime, y la flecha se quedaba sola en el renglón
			siguiente. Estos enlaces son de dos palabras, así que no hay riesgo.
		*/
		white-space: nowrap;
	}
	.ext:hover {
		background-image: linear-gradient(var(--color-neutral-300), var(--color-neutral-300));
	}
</style>
