---
import { Icon } from 'astro-icon/components';
---

{/*
	El estado real vive en localStorage y lo aplica bindSoundAttributes() al
	cargar. Renderizamos los dos estados y alternamos con CSS sobre
	data-sound-state, para que no parpadee antes de que corra el JS.
*/}
<button
	type="button"
	data-sound-toggle
	data-sound-state="muted"
	aria-pressed="false"
	aria-label="Toggle interface sound"
	class="inline-flex items-center gap-2 text-neutral-500 transition-colors hover:text-neutral-300"
>
	<Icon name="fa7-solid:volume-xmark" class="muted-only size-3.5" />
	<Icon name="fa7-solid:volume-high" class="on-only size-3.5" />
	<span class="muted-only">Sound off</span>
	<span class="on-only">Sound on</span>
</button>

<style>
	[data-sound-state='muted'] .on-only,
	[data-sound-state='on'] .muted-only {
		display: none;
	}
</style>
